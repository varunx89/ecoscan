# ===================================================================
# EcoScan Application Environment Variables
# ===================================================================

# --- Backend Configuration ---
PROJECT_NAME="EcoScan - Clothing Carbon Footprint Scanner"
VERSION=1.0.0
API_V1_STR=/api/v1

# --- Vision Model Integration ---
# Option A: Azure AI Foundry (Azure OpenAI Service) GPT-4 Vision
AZURE_OPENAI_ENDPOINT=https://your-resource-name.openai.azure.com/
AZURE_OPENAI_API_KEY=your_azure_openai_api_key_here
AZURE_OPENAI_DEPLOYMENT_NAME=gpt-4o
AZURE_OPENAI_API_VERSION=2024-06-01

# Option B: Standard OpenAI API Key (Alternative)
OPENAI_API_KEY=

# Note: If no API keys are provided, EcoScan automatically activates its built-in
# intelligent heuristic image vision engine for local development and offline demos.

# --- Eco-Rewards Engine Settings ---
POINTS_PER_KG_SAVED=10.0
BASE_SCAN_POINTS=15
MIN_SCAN_POINTS=25
MAX_SCAN_POINTS=500

# --- Frontend Configuration ---
VITE_API_BASE_URL=/api/v1
