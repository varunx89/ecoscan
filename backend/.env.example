# EcoScan Backend Environment Configuration

PROJECT_NAME="EcoScan - Clothing Carbon Footprint Scanner"
VERSION=1.0.0
API_V1_STR=/api/v1

# Azure AI Foundry / Azure OpenAI Vision Model Settings
# (Optional: If omitted, EcoScan automatically uses its built-in intelligent heuristic vision engine)
AZURE_OPENAI_ENDPOINT=https://your-resource-name.openai.azure.com/
AZURE_OPENAI_API_KEY=your_azure_openai_api_key_here
AZURE_OPENAI_DEPLOYMENT_NAME=gpt-4o
AZURE_OPENAI_API_VERSION=2024-06-01

# Standard OpenAI Alternative (Optional)
OPENAI_API_KEY=

# Rewards tuning
POINTS_PER_KG_SAVED=10.0
BASE_SCAN_POINTS=15
MIN_SCAN_POINTS=25
MAX_SCAN_POINTS=500
